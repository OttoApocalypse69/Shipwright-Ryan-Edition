{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ftep.invalid/schemas/third-party-components.v1.json",
  "title": "FTEP third-party component registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "projectUrl",
        "license",
        "redistributionMode",
        "integrationType",
        "version",
        "attributionRequired",
        "sourceAvailable",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "projectUrl": { "type": "string", "format": "uri" },
        "license": { "type": "string", "minLength": 1 },
        "redistributionMode": {
          "enum": [
            "BUNDLED_SOURCE_AND_BINARY",
            "EXTERNAL",
            "MANUAL_ONLY",
            "BLOCKED_PENDING_REVIEW"
          ]
        },
        "integrationType": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "attributionRequired": { "type": "boolean" },
        "sourceAvailable": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
