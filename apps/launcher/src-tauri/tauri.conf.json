{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SRE",
  "version": "0.1.0",
  "identifier": "environment.sre.launcher",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SRE — Super Runtime Environment",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      },
      {
        "label": "overlay",
        "title": "SRE Overlay",
        "url": "index.html?overlay=1",
        "width": 430,
        "height": 150,
        "x": 24,
        "y": 24,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.mobygames.com https://closeup.de https://www.eruditorumpress.com https://i5.walmartimages.com https://geo-online.co.jp https://assets.nintendo.com https://static.actugaming.net; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../resources/runtime/": "runtime/",
      "../resources/trust/": "trust/",
      "../resources/extractor/": "extractor/",
      "../../../soh/assets/yml/": "extractor/yml/"
    },
    "publisher": "SRE Project",
    "shortDescription": "One library. Multiple runtimes. Far too much infrastructure.",
    "longDescription": "Super Runtime Environment desktop library, powered by the FICSIT Treaty Enforcement Platform.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "startMenuFolder": "SRE"
      }
    }
  }
}
