# Required by Auth.js in every deployed environment.
AUTH_SECRET=replace-with-a-random-32-byte-secret
AUTH_TRUST_HOST=true

# One configured provider is sufficient. GitHub is the RC reference provider.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_OIDC_ID=
AUTH_OIDC_SECRET=
AUTH_OIDC_ISSUER=

# Development only. Never enable local password accounts in production; use a
# configured OAuth/OIDC provider there instead.
FTEP_LOCAL_CREDENTIALS_ENABLED=false

# Comma-separated account emails that receive the FTEP admin role.
FTEP_ADMIN_EMAILS=

# PostgreSQL must use TLS in production.
DATABASE_URL=postgresql://ftep:password@localhost:5432/ftep
# Optional development-only fallback when local PostgreSQL is offline. Defaults
# to %LOCALAPPDATA%\\Shipwright Ryan Edition\\ftep\\local-accounts.json.
FTEP_LOCAL_ACCOUNT_STORE=
# Development-only device, Accord, entitlement, and lease state. Defaults to
# %LOCALAPPDATA%\\Shipwright Ryan Edition\\ftep\\local-control-plane.json.
FTEP_LOCAL_CONTROL_PLANE_STORE=
# Development-only cached lease lifetime. The default is 30 days.
FTEP_LOCAL_LEASE_TTL_SECS=2592000
# Production lease lifetime in seconds. Keep this bounded; revocation takes
# effect for newly issued leases and reconnecting clients.
FTEP_LEASE_TTL_SECS=86400
# Signed desktop request clock-skew window, bounded by the server.
FTEP_DEVICE_REQUEST_WINDOW_SECS=300

# Public GitHub repository used for release discovery.
FTEP_GITHUB_REPOSITORY=owner/repository
NEXT_PUBLIC_FTEP_BASE_URL=http://localhost:3000

# Server-only Ed25519 secrets. Never expose these as NEXT_PUBLIC_*.
FTEP_LEASE_SIGNING_PRIVATE_KEY=
FTEP_RELEASE_SIGNING_PRIVATE_KEY=
FTEP_RELEASE_SIGNING_PUBLIC_KEY=
FTEP_SIGNING_KEY_ID=production-1
